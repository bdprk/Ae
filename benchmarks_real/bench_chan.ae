fn main() {
    let t0 = now_ms();
    let ch = chan_new(256);
    let worker = spawn(|| -> bool {
        var i = 1;
        while i <= 200000 {
            let _ = chan_send(ch, i);
            i = i + 1;
        }
        return true;
    });
    var sum = 0;
    var j = 0;
    while j < 200000 {
        sum = sum + chan_recv(ch);
        j = j + 1;
    }
    let _ = wait(worker);
    let t1 = now_ms();
    print(sum);
    print(t1 - t0);
}
