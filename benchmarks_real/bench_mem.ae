fn main() {
    let t0 = now_ms();
    var v = strvec_new();
    var i = 0;
    while i < 500000 {
        push(v, "item_" + to_string(i));
        i = i + 1;
    }
    var total = 0;
    var j = 0;
    while j < len(v) {
        total = total + len(v[j]);
        j = j + 1;
    }
    let t1 = now_ms();
    print(total);
    print(t1 - t0);
}
