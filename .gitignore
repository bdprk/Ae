/target

# generated benchmark input
bench-input.txt

# Generated by example programs when run in the repository root
examples/*.summary
ae-report/
ae-json/
__pycache__/

# isolated build dir for verifying changes while a fuzz segment owns target/
target-window/

# local benchmark binaries; only sources + reports are tracked
benchmarks_real/*.exe
benchmarks_real/*.pdb
benchmarks_real/bench_*_mojo

# live fuzz campaigns write here while they run; archive the finished
# segment logs deliberately, so a running campaign never leaves the
# worktree dirty
bench/results/*/windows-*.log
bench/results/*/windows-*.stderr.log
bench/results/*/summary.json

# local scratch space for repros and commit messages
/work/
