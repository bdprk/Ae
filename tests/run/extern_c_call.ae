// M2.12 slice 4 (spec/unsafe.md 4.1, U5): an `extern "C"` declaration names
// a C symbol the program links against; the call is unsafe (the compiler
// knows none of the callee's preconditions) and lands inside `unsafe`. The
// probe helper lives in the extended runtime, so the same declaration and
// call run on both platforms without depending on a libc signature.
extern "C" fn ae_extern_probe(v: i64) -> i64;
fn main() {
    unsafe {
        print(ae_extern_probe(20));
        print(ae_extern_probe(-3));
    }
    print("done");
}
