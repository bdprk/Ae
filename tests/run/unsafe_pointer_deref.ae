// M2.12 slice 2 (spec/unsafe.md 2.2, U1): `&v as *const T` takes the address
// of a local, and `p.deref()` reads through it — inside `unsafe` only. The
// pointer reads the slot's current value, so an assignment after the pointer
// is taken is visible through it, exactly as the compiled backends' address
// semantics say. The interp models the pointer as the slot, the backends as
// a real address; the four modes agree.
fn main() {
    var v = 1;
    let p = &v as *const i64;
    v = 2;
    unsafe {
        print(p.deref());
    }
    var w = 42;
    let q = &w as *const i64;
    unsafe {
        print(q.deref());
    }
    print("done");
}
