fn main() {
    let clk = clock_new();
    print(clock_now(clk));

    // L1: equal deadlines
    let t1 = timer_new(clk, 50);
    let t2 = timer_new(clk, 50);
    let t3 = timer_new(clk, 100);
    print(timer_ready(t1));
    print(timer_ready(t2));

    // L2: cancel t3 before deadline
    print(timer_cancel(t3));
    print(timer_cancel(t3));

    print(clock_advance(clk, 50));
    print(timer_ready(t1));
    print(timer_ready(t2));
    // Post-deadline cancel returns false
    print(timer_cancel(t1));

    // Advance past t3's deadline: cancelled timer stays unready
    print(clock_advance(clk, 60));
    print(timer_ready(t3));

    // L3: task executor drives a timeout using controlled clock + yield
    let ex = exec_new();
    let deadline = timer_new(clk, 30);
    task_spawn(ex, || -> i64 {
        var polls = 0;
        while !timer_ready(deadline) {
            polls = polls + 1;
            task_yield();
        }
        print(polls);
        print("timeout_fired");
        return 0;
    });
    task_spawn(ex, || -> i64 {
        let a1 = clock_advance(clk, 15);
        task_yield();
        let a2 = clock_advance(clk, 15);
        return a1 + a2;
    });
    print(exec_run(ex));
    print(clock_now(clk));
}
