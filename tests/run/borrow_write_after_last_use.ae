// Borrow matrix §3.2/§3.1, allowed under L1 (M2.5): a write to the base
// after the view's last use is outside the view's NLL region — the borrow
// dies at the read, not at the scope's end. Two views of one base whose
// last uses both precede the write behave the same way; the run prints the
// two views and the new value.
fn main() {
    var s = "abcdef";
    let head = slice_view(s, 0, 3);
    print(head);
    s = "other";
    print(s);
    let tail = slice_view(s, 2, 5);
    print(tail);
    s = "zzz";
    print(s);
}
