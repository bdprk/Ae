// M2.12 slice 1 (spec/unsafe.md 3.1): an `unsafe { ... }` block is a scoping
// container — the inner statements run inline, locals bind and die inside it,
// and every backend emits the same program. No unchecked operation exists
// yet, so the block changes nothing but the syntax.
fn main() {
    var s = "hello";
    unsafe {
        print(s);
        let inner = len(s);
        print(inner);
    }
    print("done");
}
