// M2.12 slice 3 (spec/unsafe.md 2.2): `&mut v as *mut T` takes a mutable
// pointer to a `var` local, and `*p = value;` writes through it — inside
// `unsafe` only, and only for pointees that can neither move nor release.
// The write lands in the pointed variable: the variable, the pointer, and a
// second pointer taken afterwards all observe it, on every backend.
fn main() {
    var n = 1;
    let p = &mut n as *mut i64;
    unsafe {
        *p = 7;
        print(n);
        print(p.deref());
    }
    let q = &n as *const i64;
    unsafe {
        print(q.deref());
    }
    print(n);
    print("done");
}
