// M2.12 slice 5 (spec/unsafe.md 3.1, U3's shape): an `unsafe fn` declares a
// function whose call is the unchecked operation — its body parses like any
// other function, and the call site requires `unsafe`. The four backends
// compile it as the ordinary function it is.
unsafe fn poke(v: i64) -> i64 {
    return v * 3;
}
fn main() {
    unsafe {
        print(poke(4));
    }
    print("done");
}
