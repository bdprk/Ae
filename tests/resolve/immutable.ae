// The compiler rejects every assignment here; emit-resolve still dumps it,
// pinning the resolver's writability diagnostics (probes w1/w2/w5/w7/w8).
struct S { a: i64 }

impl S {
    fn peek(&self) -> i64 {
        return self.a;
    }
    fn replace(&mut self, v: i64) -> i64 {
        self.a = v;
        return self.a;
    }
}

fn by_value(s: S) -> i64 {
    s.a = 1;
    return s.a;
}

fn rebind(x: i64) -> i64 {
    x = 2;
    return x;
}

fn main() {
    let x = 1;
    x = 2;
    let s = S { a: 0 };
    s.a = 3;
    print(x);
    print(s.peek());
}
