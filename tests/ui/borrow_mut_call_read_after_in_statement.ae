// The ordered face (M2.5): arguments evaluate left to right, so the view
// read in the second argument follows the mut call that released it — the
// ordered walk rejects what the statement-level suffix rule cannot see.
struct Doc { name: string, note: string }

impl Doc {
    fn rename(&mut self, to: string) -> i64 {
        self.name = to;
        return len(self.name);
    }
}

fn combine(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() {
    var d = Doc { name: "alpha", note: "keep" };
    let head = slice_view(d.name, 0, 3);
    let n = combine(d.rename("beta"), len(head));
    print(n);
}
