// Borrow matrix §3.2 under L1 (M2.5): the flip side of the allowance. The
// view is still read after the write, so the write releases bytes the view
// points at — the deferred conflict is adjudicated on the graph and
// rejected with the positioned NLL diagnostic.
fn main() {
    var s = "abcdef";
    let a = slice_view(s, 0, 3);
    s = "other";
    print(a);
}
