// The second line of defense: even an immutable view binding cannot be
// re-pointed — the immutable-binding rule rejects the write, and the view
// slot check (M2.5) would reject it for any StrView or Tokens slot the
// assignment path can reach.
fn main() {
    var s = "abcdef";
    let h = slice_view(s, 0, 3);
    print(h);
    h = slice_view(s, 2, 5);
    print(h);
}
