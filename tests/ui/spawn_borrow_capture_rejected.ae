// M4.1.01/M4.1.02 (ADR-0214, ADR-0215): a borrow capture is accepted only
// when the handle is provably joined before the borrowed region ends. This
// program never waits, so no join can be proven on the escaping path — the
// pinned rejection keeps the scoped rule honest.
fn main() {
    var s = "hello";
    let t = spawn(|| -> i64 { return len(s); });
    print(1);
}
