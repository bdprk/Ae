// Borrow matrix §3.1: two shared loans of one base coexist for reads, but a
// write path while either is live is rejected. The views' regions run to the
// scope's end, so the write after their last use is still rejected at this
// level; the L1 NLL relaxation must produce its differential baseline before
// loosening exactly this shape.
fn main() {
    var s = "abcdef";
    let a = slice_view(s, 0, 3);
    let b = slice_view(s, 2, 5);
    print(a);
    print(b);
    s = "other";
    print(s);
}
