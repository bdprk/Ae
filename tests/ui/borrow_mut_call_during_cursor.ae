// The flip side: the mut call releases the cursor's base while the loop
// may still read it — the deferred conflict is adjudicated and rejected.
struct Doc { name: string, note: string }

impl Doc {
    fn rename(&mut self, to: string) -> i64 {
        self.name = to;
        return len(self.name);
    }
}

fn main() {
    var d = Doc { name: "a,b,c", note: "keep" };
    let cur = tokenize(d.name, ",");
    for t in cur {
        let n = d.rename("z");
        print(t);
    }
}
