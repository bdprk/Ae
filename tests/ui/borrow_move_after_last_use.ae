// Borrow matrix §3.3: moving the base while a borrow is active is rejected.
// The view's last use precedes the move, but the region still covers it at
// this level; moving after the last use is the L1 allowance, gated on the
// same differential baseline as the write case.
fn main() {
    var s = "abcdef";
    let a = slice_view(s, 0, 3);
    print(a);
    let t = s;
    print(t);
}
