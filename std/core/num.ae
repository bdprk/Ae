// std/core/num.ae
// Core Numeric and Signedness Traits (M1.4 / M1.7)

pub trait SignedMagnitude {
    fn magnitude(x: T) -> T;
    fn sign_indicator(x: T) -> i64;
}

impl SignedMagnitude for i64 {
    fn magnitude(x: i64) -> i64 {
        if x < 0 {
            return -x;
        }
        return x;
    }

    fn sign_indicator(x: i64) -> i64 {
        if x > 0 {
            return 1;
        }
        if x < 0 {
            return -1;
        }
        return 0;
    }
}