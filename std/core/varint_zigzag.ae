// std/core/varint_zigzag.ae
// Signed integer ZigZag encoding and decoding primitives for AE core.

pub fn zigzag_encode_i64(n: i64) -> i64 {
    // (n << 1) ^ (n >> 63)
    // In positive arithmetic: if n >= 0, 2 * n; if n < 0, 2 * (-n) - 1
    if n >= 0 {
        return n * 2;
    }
    return (0 - n) * 2 - 1;
}

pub fn zigzag_decode_i64(n: i64) -> i64 {
    if n % 2 == 0 {
        return n / 2;
    }
    return 0 - ((n + 1) / 2);
}
