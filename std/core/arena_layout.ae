// std/core/arena_layout.ae
// Core Arena chunk and layout calculation primitives.

pub struct ArenaLayout {
    align: i64,
    size: i64,
}

pub fn arena_layout_new(align: i64, size: i64) -> ArenaLayout {
    var valid_align = align;
    if valid_align <= 0 {
        valid_align = 1;
    }
    return ArenaLayout {
        align: valid_align,
        size: size,
    };
}

pub fn arena_layout_align_up(offset: i64, align: i64) -> i64 {
    if align <= 1 {
        return offset;
    }
    let rem = offset % align;
    if rem == 0 {
        return offset;
    }
    return offset + (align - rem);
}

pub fn arena_layout_fits(offset: i64, req_size: i64, align: i64, capacity: i64) -> bool {
    let aligned_start = arena_layout_align_up(offset, align);
    return aligned_start + req_size <= capacity;
}
