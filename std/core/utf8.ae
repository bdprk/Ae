// std/core/utf8.ae
// UTF-8 byte boundary and character length primitives.

pub fn is_utf8_continuation_byte(b: i64) -> bool {
    // UTF-8 continuation bytes have bits 10xxxxxx (0x80 to 0xBF)
    return b >= 128 && b <= 191;
}

pub fn utf8_sequence_length(first_byte: i64) -> i64 {
    if first_byte >= 0 && first_byte <= 127 {
        return 1;
    }
    if first_byte >= 192 && first_byte <= 223 {
        return 2;
    }
    if first_byte >= 224 && first_byte <= 239 {
        return 3;
    }
    if first_byte >= 240 && first_byte <= 247 {
        return 4;
    }
    return 0;
}
