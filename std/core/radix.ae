// std/core/radix.ae
// Radix formatting length and digit counting primitives for ae core.

pub fn radix10_digit_count(val: i64) -> i64 {
    if val == 0 {
        return 1;
    }
    var v = val;
    if v < 0 {
        v = 0 - v;
    }
    var count = 0;
    while v > 0 {
        count = count + 1;
        v = v / 10;
    }
    return count;
}

pub fn radix16_digit_count(val: i64) -> i64 {
    if val == 0 {
        return 1;
    }
    var v = val;
    if v < 0 {
        v = 0 - v;
    }
    var count = 0;
    while v > 0 {
        count = count + 1;
        v = v / 16;
    }
    return count;
}
