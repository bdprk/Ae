// std/core/iter.ae
// Core Iterator Trait Specification & Range Iterator (M1.8)

pub trait Iterator {
    fn next(it: T) -> Option[i64];
}

pub struct Range {
    current: i64,
    end: i64,
}

impl Iterator for Range {
    fn next(it: Range) -> Option[i64] {
        if it.current < it.end {
            return Option[i64]::Some(it.current);
        }
        return Option[i64]::None;
    }
}