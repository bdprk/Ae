// std/core/bump_alloc.ae
// Zero-allocation bump allocator state manager for fast arena allocations.

pub struct BumpAlloc {
    offset: i64,
    capacity: i64,
    high_watermark: i64,
}

pub fn bump_alloc_new(capacity: i64) -> BumpAlloc {
    return BumpAlloc {
        offset: 0,
        capacity: capacity,
        high_watermark: 0,
    };
}

pub fn bump_alloc_offset(b: BumpAlloc) -> i64 {
    return b.offset;
}

pub fn bump_alloc_capacity(b: BumpAlloc) -> i64 {
    return b.capacity;
}

pub fn bump_alloc_remaining(b: BumpAlloc) -> i64 {
    return b.capacity - b.offset;
}

pub fn bump_alloc_allocate(b: BumpAlloc, size: i64, align: i64) -> BumpAlloc {
    let raw = b.offset;
    let cap = b.capacity;
    let old_hw = b.high_watermark;
    let rem = raw % align;
    var aligned = raw;
    if rem > 0 {
        aligned = raw + (align - rem);
    }
    let new_offset = aligned + size;
    if new_offset > cap {
        // Out of memory for this bump arena, keep state
        return BumpAlloc {
            offset: raw,
            capacity: cap,
            high_watermark: old_hw,
        };
    }
    var hw = old_hw;
    if new_offset > hw {
        hw = new_offset;
    }
    return BumpAlloc {
        offset: new_offset,
        capacity: cap,
        high_watermark: hw,
    };
}

pub fn bump_alloc_reset(b: BumpAlloc) -> BumpAlloc {
    return BumpAlloc {
        offset: 0,
        capacity: b.capacity,
        high_watermark: b.high_watermark,
    };
}
