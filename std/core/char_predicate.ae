// std/core/char_predicate.ae
// Identifier character predicate lookup state primitives for ae core.

use "ascii_table.ae";

pub fn is_ident_start(c: i64) -> bool {
    // [a-zA-Z_] : 'A'..'Z' is 65..90, 'a'..'z' is 97..122, '_' is 95
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
        return true;
    }
    return false;
}

pub fn is_ident_continue(c: i64) -> bool {
    // [a-zA-Z0-9_] : '0'..'9' is 48..57
    if is_ident_start(c) || (c >= 48 && c <= 57) {
        return true;
    }
    return false;
}

pub fn is_hex_prefix(c0: i64, c1: i64) -> bool {
    // "0x" or "0X": c0 == 48 and (c1 == 120 or c1 == 88)
    return c0 == 48 && (c1 == 120 || c1 == 88);
}
