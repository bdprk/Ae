// std/core/stack.ae
// Fixed-capacity Stack primitive for ae core.

pub struct FixedStack8 {
    len: i64,
}

pub fn stack8_new() -> FixedStack8 {
    return FixedStack8 { len: 0 };
}

pub fn stack8_len(s: FixedStack8) -> i64 {
    return s.len;
}

pub fn stack8_is_empty(s: FixedStack8) -> bool {
    return s.len == 0;
}

pub fn stack8_is_full(s: FixedStack8) -> bool {
    return s.len >= 8;
}

pub fn stack8_push(s: FixedStack8) -> FixedStack8 {
    if s.len < 8 {
        return FixedStack8 { len: s.len + 1 };
    }
    return s;
}

pub fn stack8_pop(s: FixedStack8) -> FixedStack8 {
    if s.len > 0 {
        return FixedStack8 { len: s.len - 1 };
    }
    return s;
}
