// std/core/math.ae
// Core Mathematical & Algorithmic Primitives (M1.4)

pub fn math_max(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn math_min(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn math_clamp(val: i64, low: i64, high: i64) -> i64 {
    if val < low {
        return low;
    }
    if val > high {
        return high;
    }
    return val;
}