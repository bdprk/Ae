// std/core/alignment_mask.ae
// Power-of-two alignment check and padding primitives for AE core.

pub fn is_power_of_two(val: i64) -> bool {
    if val <= 0 {
        return false;
    }
    var v = val;
    while v % 2 == 0 {
        v = v / 2;
    }
    return v == 1;
}

pub fn alignment_padding_needed(offset: i64, align: i64) -> i64 {
    if align <= 1 {
        return 0;
    }
    let rem = offset % align;
    if rem == 0 {
        return 0;
    }
    return align - rem;
}
