// std/core/simd_dot.ae
// Conceptual 4-lane SIMD dot product and fused multiply-accumulate (FMA) primitive.

pub struct Lane4Vec {
    v0: i64,
    v1: i64,
    v2: i64,
    v3: i64,
}

pub fn lane4_vec_new(a: i64, b: i64, c: i64, d: i64) -> Lane4Vec {
    return Lane4Vec {
        v0: a,
        v1: b,
        v2: c,
        v3: d,
    };
}

pub fn lane4_vec_v0(l: Lane4Vec) -> i64 {
    return l.v0;
}

pub fn lane4_vec_v3(l: Lane4Vec) -> i64 {
    return l.v3;
}

pub fn lane4_vec_dot(a: Lane4Vec, b: Lane4Vec) -> i64 {
    return a.v0 * b.v0 + a.v1 * b.v1 + a.v2 * b.v2 + a.v3 * b.v3;
}

pub fn lane4_vec_mul(a: Lane4Vec, b: Lane4Vec) -> Lane4Vec {
    return Lane4Vec {
        v0: a.v0 * b.v0,
        v1: a.v1 * b.v1,
        v2: a.v2 * b.v2,
        v3: a.v3 * b.v3,
    };
}

pub fn lane4_vec_fma(a: Lane4Vec, b: Lane4Vec, c: Lane4Vec) -> Lane4Vec {
    return Lane4Vec {
        v0: a.v0 * b.v0 + c.v0,
        v1: a.v1 * b.v1 + c.v1,
        v2: a.v2 * b.v2 + c.v2,
        v3: a.v3 * b.v3 + c.v3,
    };
}
