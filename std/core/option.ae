// std/core/option.ae
// Core Option[T] algebraic data type definition (M1.2/M1.10)

pub enum Option[T] {
    Some(T),
    None,
}

impl[T] Option[T] {
    pub fn is_some(&self) -> bool {
        match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    pub fn is_none(&self) -> bool {
        match self {
            Option::Some(_) => false,
            Option::None => true,
        }
    }

    pub fn unwrap_or(self, default_val: T) -> T {
        match self {
            Option::Some(val) => val,
            Option::None => default_val,
        }
    }
}
