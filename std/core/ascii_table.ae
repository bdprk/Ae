// std/core/ascii_table.ae
// ASCII character classification lookup table state primitives for ae core.

pub fn ascii_to_uppercase(c: i64) -> i64 {
    if c >= 97 && c <= 122 {
        return c - 32;
    }
    return c;
}

pub fn ascii_to_lowercase(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

pub fn ascii_is_hex_digit(c: i64) -> bool {
    if c >= 48 && c <= 57 {
        return true;
    }
    if c >= 65 && c <= 70 {
        return true;
    }
    if c >= 97 && c <= 102 {
        return true;
    }
    return false;
}

pub fn ascii_hex_to_val(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 65 && c <= 70 {
        return c - 65 + 10;
    }
    if c >= 97 && c <= 102 {
        return c - 97 + 10;
    }
    return -1;
}
