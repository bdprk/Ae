// std/core/result_combinators.ae
// Core Result Combinators (M1.8 / M1.11)

use "result.ae";

pub fn result_is_ok[T, E](r: &Result[T, E]) -> bool {
    match r {
        Result::Ok(_) => return true,
        Result::Err(_) => return false,
    }
}

pub fn result_unwrap_or[T, E](r: Result[T, E], fallback: T) -> T {
    match r {
        Result::Ok(val) => return val,
        Result::Err(_) => return fallback,
    }
}