// std/core/char_escape.ae
// Standard escape sequence character decoding primitives for lexers.

pub fn escape_char_to_byte(c: i64) -> i64 {
    // 'n' (110) -> '\n' (10)
    if c == 110 {
        return 10;
    }
    // 'r' (114) -> '\r' (13)
    if c == 114 {
        return 13;
    }
    // 't' (116) -> '\t' (9)
    if c == 116 {
        return 9;
    }
    // '\\' (92) -> '\\' (92)
    if c == 92 {
        return 92;
    }
    // '"' (34) -> '"' (34)
    if c == 34 {
        return 34;
    }
    // '0' (48) -> '\0' (0)
    if c == 48 {
        return 0;
    }
    return -1;
}

pub fn is_valid_escape_char(c: i64) -> bool {
    return escape_char_to_byte(c) >= 0;
}
