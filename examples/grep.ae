// File search: counts lines containing a pattern (workload B baseline).
// Line boundaries come from bytes(); matching uses the platform's
// optimized substring search via contains().

fn main() {
    let text = read_file("bench-input.txt");
    let data = bytes(text);
    let n = len(data);
    var line_start = 0;
    var matches = 0;
    var lines = 0;
    for i in 0..n {
        if data[i] == 10 {
            lines = lines + 1;
            if contains(slice(text, line_start, i), "ae") {
                matches = matches + 1;
            }
            line_start = i + 1;
        }
    }
    if n > line_start {
        lines = lines + 1;
        if contains(slice(text, line_start, n), "ae") {
            matches = matches + 1;
        }
    }
    print(lines);
    print(matches);
}
