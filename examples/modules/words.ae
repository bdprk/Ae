// Word counting, exported for importers. Only `pub` items cross the file
// boundary: `is_blank` stays private to this module.

fn is_blank(text: &string) -> bool {
    return len(text) == 0;
}

pub fn count_words(text: &string) -> map[string, i64] {
    var counts = map_new();
    let words = split(text, " ");
    for word in words {
        if is_blank(word) { continue; }
        let seen = map_get(counts, word);
        match seen {
            IntResult::Ok(n) => { counts[word] = n + 1; }
            IntResult::Err(reason) => { counts[word] = 1; }
        }
    }
    return counts;
}
