// The map.ae workload rewritten with `map_inc`, the single-lookup counting
// builtin. Diagnostic twin for API-shape comparison: identical output, same
// LCG and checksum loop, only the draw body differs (one map_inc instead of
// map_get + match + index store). Not part of the four-language twin set.

fn main() {
    var counts = map_new();
    var x = 1234567;
    for j in 0..1000000 {
        x = (x * 48271) % 2147483647;
        var key = "k" + to_string(x % 10000);
        let seen = map_inc(counts, key, 1);
    }
    var checksum = 0;
    for i in 0..10000 {
        var key = "k" + to_string(i);
        let c = map_get(counts, key);
        match c {
            IntResult::Ok(n) => { checksum = checksum + n * (i + 1); }
            IntResult::Err(reason) => { checksum = checksum + 0; }
        }
    }
    print("draws=1000000");
    print("keys=10000");
    print("distinct=" + to_string(len(counts)));
    print("total=1000000");
    print("checksum=" + to_string(checksum));
}
