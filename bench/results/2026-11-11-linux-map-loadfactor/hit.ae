// 1M lookups that all hit a pre-filled 10000-key map: isolates per-lookup cost.
fn main() {
    var counts = map_new();
    for i in 0..10000 {
        let k = "k" + to_string(i);
        let n = map_inc(counts, k, i + 1);
    }
    var x = 1234567;
    var acc = 0;
    for j in 0..1000000 {
        x = (x * 48271) % 2147483647;
        let key = "k" + to_string(x % 10000);
        let c = map_get(counts, key);
        match c {
            IntResult::Ok(n) => { acc = acc + n; }
            IntResult::Err(reason) => { acc = acc + 0; }
        }
    }
    print(acc);
}
