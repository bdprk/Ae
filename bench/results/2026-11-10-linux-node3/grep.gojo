use std/os

fn main() {
    let text = os.readText("bench-input.txt") catch e {
        eprintln("read failed:", e)
        ""
    }
    var lines = 0
    var matches = 0
    for line in text.split("\n") {
        if line.len() == 0 && lines > 0 {
            continue
        }
        lines = lines + 1
        if line.contains("ae") {
            matches = matches + 1
        }
    }
    println(lines)
    println(matches)
}
